{
  "name": "livepasses",
  "version": "0.1.0",
  "description": "Official Node.js/TypeScript SDK for the Livepasses API - Digital wallet pass generation, management, and redemption",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "livepasses",
    "wallet",
    "apple-wallet",
    "google-wallet",
    "pass",
    "digital-wallet",
    "sdk",
    "api"
  ],
  "author": "Livepasses <support@livepasses.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/livepasses/livepasses-node.git"
  },
  "homepage": "https://docs.livepasses.com",
  "bugs": {
    "url": "https://github.com/livepasses/livepasses-node/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  }
}
